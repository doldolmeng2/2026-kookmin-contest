<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bag_motion_replay</name>
  <version>0.1.0</version>
  <description>
    Byte-exact, deadline-scheduled replay of the drive command topics recorded in a
    rosbag2, so the vehicle repeats a recorded run without re-deriving anything from
    the joystick.
  </description>
  <maintainer email="ktypet13@hanyang.ac.kr">xytron</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
